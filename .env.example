# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Public origin used in URLs returned to clients. On Render, this is optional:
# the server falls back to RENDER_EXTERNAL_URL (and RENDER_EXTERNAL_HOSTNAME),
# which Render injects automatically. Set it explicitly to override that, e.g.
# https://mizx.onrender.com.
PUBLIC_URL=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Required when NODE_ENV=production. Generate with:
#   openssl rand -hex 48
JWT_SECRET=

# Comma-separated browser origins, or * to allow any origin.
CORS_ORIGIN=*

# Set to 1 when running behind one reverse proxy (Render, Nginx, etc.).
TRUST_PROXY=0

ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
HANDSHAKE_TTL_SECONDS=600

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=60

# ---------------------------------------------------------------------------
# Game / analysis constants
# ---------------------------------------------------------------------------
GAME_VERSION=1.38.2
GAME_VERSION_CODE=2019071114
GARENA_APP_ID=100067
GARENA_SOURCE_ID=2
DEFAULT_REGION=sg
MAX_ROOMS=100

# ---------------------------------------------------------------------------
# WebSocket
# ---------------------------------------------------------------------------
WS_MAX_PAYLOAD_BYTES=65536
WS_HEARTBEAT_MS=30000
WS_MESSAGE_WINDOW_MS=10000
WS_MESSAGE_LIMIT=40
